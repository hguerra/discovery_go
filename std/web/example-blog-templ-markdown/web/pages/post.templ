package pages

import "example-blog-templ-markdown/web/components"
import "example-blog-templ-markdown/internal/domain/posts"
import "fmt"

templ Post(post posts.Post) {
	@components.Base(post.Title) {
		<div class="container mx-auto">
			<h1 class="text-4xl font-bold text-center">{ post.Title }</h1>

      if post.Author.Name != "" {
        <div class="text-center mt-4">
				  <p class="text-gray-500">Author: <a href={templ.URL(fmt.Sprintf("mailto:%s", post.Author.Email)) }>{ post.Author.Name }</a></p>
			  </div>
      }

			<div class="prose max-w-full">
        @templ.Raw(post.Content)
			</div>
		</div>
	}
}
